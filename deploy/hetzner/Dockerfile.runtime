FROM python:3.12-slim

WORKDIR /app
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY pyproject.toml .
COPY app/ app/
RUN pip install --no-cache-dir -e . && python -m playwright install --with-deps chromium

COPY agent/ agent/
COPY config.yaml config.yaml
COPY deploy/hetzner/postprocess.py deploy/hetzner/postprocess.py
COPY deploy/hetzner/smoke_worker.py deploy/hetzner/smoke_worker.py

ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
