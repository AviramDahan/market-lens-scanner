MARKET_LENS_HETZNER_WRITER_ENABLED=false
MARKET_LENS_OLD_WRITERS_DISABLED=false
GIT_SSH_COMMAND="ssh -i /home/trader/.ssh/market_lens_deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
# Activate only after a full remote bootstrap restore is verified.
MARKET_LENS_HOST_BACKUP_BACKEND=legacy_git
# Optional: verified private offsite copies of closed backups older than 7 days.
# Keeps the newest two locally; never touches live portfolio files or Git history.
MARKET_LENS_COLD_BACKUP_ARCHIVE_ENABLED=false
